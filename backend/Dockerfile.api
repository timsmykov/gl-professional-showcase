FROM python:3.12-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock ./
COPY gl_bot/__init__.py gl_bot/__init__.py
COPY gl_api/ gl_api/
COPY migrations/ migrations/
COPY alembic.ini ./
RUN uv sync --frozen --no-dev --no-install-project && \
    groupadd --gid 10001 glapi && useradd --uid 10001 --gid 10001 --no-create-home glapi
USER 10001:10001
EXPOSE 8000
CMD [".venv/bin/python", "-m", "gl_api"]

FROM runtime AS test
USER root
COPY gl_bot/ gl_bot/
COPY tests/api/ tests/api/
COPY tests/db/ tests/db/
COPY tests/fixtures/ tests/fixtures/
COPY infra/ infra/
COPY sql/001_init.sql sql/001_init.sql
RUN uv sync --frozen --extra test --no-install-project
USER 10001:10001
CMD [".venv/bin/pytest", "-q", "-p", "no:cacheprovider", "tests/api", "tests/db"]
