---
import { collagenExplainer as content } from '@/content/collagen-explainer';
interface Props {
  currentSlug: string;
}
const { currentSlug } = Astro.props;
---

<div class="collagen-explainer" data-collagen-explainer>
  <figure data-illustration="collagen">
    <img
      src="/images/illustrations/collagen-triple-helix-20261011.webp"
      alt="Общая схема: три различимые цепи, переплетённые в тройную спираль коллагена"
      width="1536"
      height="1024"
      loading="lazy"
      decoding="async"
      draggable="false"
    />
    <figcaption>{content.caption}</figcaption>
  </figure>
  <div class="collagen-copy">
    <h3>{content.heading}</h3>
    <p>{content.structure}</p>
    <p>{content.composition}</p>
    <dl
      class="collagen-comparison"
      aria-label="Содержание рекомбинантного коллагена"
    >
      {content.products.map((item) => (
        <div>
          <dt>
            <a
              href={`/products/${item.slug}/`}
              aria-current={item.slug === currentSlug ? 'page' : undefined}
            >
              {item.title}
            </a>
          </dt>
          <dd>{item.concentration}</dd>
        </div>
      ))}
    </dl>
    <a class="structure-source" href={content.sourceUrl}>
      О структуре коллагена — RCSB PDB-101
    </a>
  </div>
</div>

<style>
  .collagen-explainer {
    display: grid;
    gap: 28px;
    align-items: center;
    border-block: 1px solid var(--color-border);
    padding-block: 28px;
    margin-block: 32px;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  figcaption {
    color: var(--color-muted);
    font-size: var(--text-meta-size);
    line-height: 1.6;
    margin-top: 12px;
  }
  .collagen-copy {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  h3 {
    font-size: clamp(1.875rem, 3.2vw, 3rem);
    line-height: 1.15;
    margin: 0 0 20px;
  }
  p {
    margin: 0 0 20px;
    line-height: 1.6;
  }
  .collagen-comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 24px 0;
  }
  .collagen-comparison > div {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
    min-width: 0;
  }
  dt a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  dt a[aria-current] {
    font-weight: 600;
  }
  dd {
    margin: 8px 0 0;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.1;
  }
  .structure-source {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-meta-size);
  }
  @media (min-width: 1100px) {
    .collagen-explainer {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 40px;
      padding-block: 36px;
    }
  }
</style>
