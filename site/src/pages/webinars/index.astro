---
import CatalogFilter from '@/features/catalog/CatalogFilter.vue';
import SiteLayout from '@/layouts/SiteLayout.astro';
import TeamVisual from '@/components/TeamVisual.astro';
import { contentRepository } from '@/lib/content';

const webinars = await contentRepository.listWebinars();
const items = webinars.map((webinar) => ({
  slug: webinar.slug,
  title: webinar.title,
  category: webinar.format,
  categoryLabel: webinar.formatLabel,
  summary: webinar.summary,
}));
---

<SiteLayout
  title="Вебинары"
  description="Каталог вебинаров G&L Professional."
  noindex={webinars.length > 0 && webinars.every((webinar) => webinar.demo)}
>
  <header class="section section--compact">
    <div class="container">
      <h1>Вебинары</h1>
      <p class="lede">
        Обучение с Германом Черкасовым и Людмилой Чесноковой: отдельные записи и
        живые вебинары. Формат, программа и условия — на странице каждой темы.
      </p>
    </div>
  </header>
  {items.length ? (
    <div class="container section--compact">
      <CatalogFilter
        items={items}
        filters={[
          { value: 'all', label: 'Все' },
          { value: 'recording', label: 'Записи' },
          { value: 'live', label: 'Живые встречи' },
        ]}
        basePath="/webinars/"
        emptyText="По выбранному формату вебинаров пока нет."
        client:visible
      />
    </div>
  ) : (
    <section class="container empty-state" aria-labelledby="empty-title">
      <h2 id="empty-title">Вебинаров пока нет в каталоге.</h2>
    </section>
  )}
  <section class="wrap section--compact split education-layout">
    <TeamVisual education />
    <div class="format-list">
      <div>
        <h2>Записи</h2>
        <p>
          Выбирайте отдельную тему. До покупки в карточке будут указаны
          программа, спикер, длительность, цена и условия доступа.
        </p>
      </div>
      <div>
        <h2>Живые встречи</h2>
        <p>
          Даты, формат вопросов, стоимость и возможность получить запись после
          эфира будут обозначены отдельно для каждой встречи.
        </p>
      </div>
      <a class="button button-outline" href="/about/">
        О преподавателях
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  h1 {
    margin-block: 0 1rem;
    font-size: var(--display-page);
  }

  .empty-state {
    margin-block: var(--space-5) var(--space-10);
    padding: var(--space-7);
    border-radius: var(--radius-soft);
    background:
      radial-gradient(circle at 85% 20%, #ffffff99, transparent 28%),
      var(--color-ice);
  }

  .empty-state h2 {
    max-width: 13ch;
    margin-block: var(--space-3) var(--space-5);
    font-size: var(--display-subsection);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .empty-state > p:not(.eyebrow) {
    max-width: 40rem;
    color: var(--color-muted);
    line-height: var(--text-body-leading);
  }

  .empty-state .button {
    margin-top: var(--space-5);
  }

  .format-list {
    display: grid;
    gap: 24px;
    align-content: center;
  }
  .format-list > div {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }
  .format-list h2 {
    margin-block: 0 12px;
    font-size: var(--text-card-size);
  }
  .format-list p {
    max-width: 52ch;
    line-height: 1.6;
  }
  .format-list .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 760px) {
    .empty-state {
      padding: var(--space-9);
    }
  }
</style>
