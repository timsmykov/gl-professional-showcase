---
import MolecularBackground from '@/components/MolecularBackground.astro';
import { isMolecularTheme } from '@/lib/molecular-preview';
import SiteLayout from '@/layouts/SiteLayout.astro';
import HeroSculpture from '@/components/HeroSculpture.astro';
import TeamVisual from '@/components/TeamVisual.astro';
import { contentRepository } from '@/lib/content';
import TelegramButton from '@/components/TelegramButton.astro';
import ProductCard from '@/components/products/ProductCard.astro';
import '../features/motion/product-hover.css';
const molecularPreview = isMolecularTheme(Astro.site, Astro.url.pathname);
const products = await contentRepository.listProducts();
---

<SiteLayout title="G&L Professional">
  <div
    class="home"
    data-molecular-study={molecularPreview ? '' : undefined}
    data-treatment={molecularPreview ? 'pearl' : undefined}
  >
    {molecularPreview && <MolecularBackground />}
    <section class="hero home-hero wrap" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title">
          Препараты и&nbsp;обучение <span>для специалистов.</span>
        </h1>
        <p class="hero-deck">
          Бренд Германа Черкасова и Людмилы Чесноковой. Для косметологов и
          врачей.
        </p>
        <div class="hero-actions">
          <a class="button" href="/products/">
            Смотреть препараты
          </a>
          <a class="button button-outline" href="/webinars/">
            Вебинары
          </a>
        </div>
      </div>
      <div class="home-hero-art">
        <HeroSculpture />
      </div>
    </section>

    <section
      class="approach home-section"
      id="approach"
      aria-labelledby="brand-title"
    >
      <div class="wrap approach-layout">
        <div class="home-brand-copy">
          <h2 id="brand-title">
            Люди.
            <br />
            <span>За брендом G&amp;L.</span>
          </h2>
          <p>
            Герман Черкасов и Людмила Чеснокова — врачи и тренеры по
            инъекционным методам в косметологии. Их объединяют медицинская
            практика и обучение коллег.
          </p>
          <a class="button" href="/about/">
            О бренде и команде
          </a>
        </div>
        <TeamVisual />
      </div>
    </section>

    <section
      class="home-products wrap home-section"
      id="collection"
      aria-labelledby="collection-title"
    >
      <div class="home-section-heading">
        <div>
          <h2 id="collection-title">
            Четыре продукта.
            <br />
            <span>Три линейки.</span>
          </h2>
        </div>
        <a class="button button-outline" href="/products/">
          Все препараты
        </a>
      </div>
      <div class="home-products-grid" data-product-hover-group>
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </section>

    <section
      class="home-education wrap home-section"
      id="education"
      aria-labelledby="education-title"
    >
      <div class="home-education-heading">
        <h2 id="education-title">Обучение с командой G&amp;L</h2>
        <p class="home-education-intro">
          Герман Черкасов и Людмила Чеснокова делятся опытом врачебной практики
          на вебинарах для специалистов.
        </p>
      </div>
      <div class="home-formats">
        <div>
          <h3>Записи</h3>
          <p>Выберите тему и познакомьтесь с программой вебинара.</p>
        </div>
        <div>
          <h3>Живые вебинары</h3>
          <p>Присоединяйтесь к встречам и обсуждению с командой G&amp;L.</p>
        </div>
      </div>
      <div class="home-education-actions">
        <a class="button" href="/webinars/">
          Смотреть вебинары
        </a>
      </div>
    </section>

    <section
      class="pause home-section"
      id="contact-path"
      aria-labelledby="contact-title"
    >
      <div class="wrap home-contact">
        <div>
          <h2 id="contact-title">
            Вопрос о&nbsp;препарате?
            <br />
            <span>Напишите нам.</span>
          </h2>
        </div>
        <div class="home-contact-actions">
          <TelegramButton />
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  import { setupProductHover } from '../features/motion/product-hover';
  setupProductHover();
  document.addEventListener('astro:page-load', setupProductHover);
</script>

<style>
  .home {
    --home-gap: clamp(1.5rem, 3vw, 3rem);
  }
  .home h1,
  .home h2,
  .home h3 {
    margin: 0;
    text-wrap: pretty;
  }
  .home h1 span,
  .home h2 span {
    color: var(--color-heading-accent);
  }
  .home h2 {
    font-size: clamp(2.25rem, 4.5vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }
  .home p {
    max-width: 48ch;
  }
  .home-section {
    padding-block: clamp(3rem, 6vw, 6rem);
  }
  .home-hero {
    gap: 1.5rem;
    padding-block: 1.5rem 2.5rem;
  }
  .home-hero .hero-copy {
    pointer-events: auto;
    min-width: 0;
    max-width: none;
  }
  .home-hero h1 {
    font-size: clamp(1.25rem, 0.25rem + 9.5vw, 5.25rem);
    line-height: 1.06;
    letter-spacing: -0.055em;
    max-width: none;
  }
  .home-hero h1 span {
    display: block;
  }
  .home-hero .hero-deck {
    margin-block: 1.5rem;
    max-width: 40ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .home-hero-art {
    width: min(100%, 34rem);
    align-self: center;
  }
  .home-section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .home-section-heading > *,
  .home-contact > *,
  .home-formats > * {
    min-width: 0;
    max-width: 100%;
  }
  .home-products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 12px;
  }
  .home-brand-copy p {
    margin-block: 1.5rem;
  }
  .home-formats {
    display: grid;
    gap: 1.5rem;
  }
  .home-education-heading {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
    max-width: 68rem;
  }
  .home-education-heading h2 {
    margin: 0;
  }
  .home-formats > div {
    padding: clamp(20px, 3vw, 40px);
    border-radius: 24px;
    background: var(--interaction-tint);
  }
  .home-formats h3 {
    margin: 0 0 0.75rem;
  }
  .home-formats h3 {
    font-size: var(--text-card-size);
    line-height: 1.2;
  }
  .home-formats p {
    margin-bottom: 0;
    color: var(--muted);
  }
  .home-education-intro {
    margin: 0;
    color: var(--muted);
  }
  .home-education-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 2rem;
  }
  .home-contact {
    display: grid;
    gap: 2rem;
  }
  .home-contact p {
    margin-block: 1.5rem 0;
  }
  .home-contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }
  @media (max-width: 479px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .home-contact-actions .button {
      width: 100%;
    }
  }
  @media (min-width: 760px) {
    .home-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      align-items: center;
      gap: var(--home-gap);
      min-height: calc(100svh - var(--header-height));
      padding-block: 2rem;
    }
    .home-hero h1 {
      font-size: clamp(1.5rem, 0.25rem + 5vw, 5.25rem);
    }
    .home-hero-art {
      width: 100%;
    }
    .home-section-heading {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--home-gap);
    }
    .home-section-heading > p {
      max-width: 32ch;
    }
    .home-products-grid {
      gap: 20px;
    }
    .home-formats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
    .home-education-actions {
      flex-direction: row;
      align-items: center;
      gap: var(--home-gap);
    }
  }
  @media (min-width: 760px) and (max-width: 999px) {
    .home-hero {
      min-height: 0;
      padding-block: 3rem;
    }
  }
  @media (min-width: 1000px) {
    .home-contact {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      align-items: center;
      gap: var(--home-gap);
    }
  }
  @media (min-width: 1000px) and (max-height: 760px) {
    .home .approach {
      padding-block: 16px;
    }
  }
  @media (min-width: 1100px) {
    .home-products-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
